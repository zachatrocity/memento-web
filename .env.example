# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# Session & Security
SESSION_SECRET=change_this_to_a_random_string

# Server Configuration
PORT=3000
NODE_ENV=production

# Video Output Volume (where videos are saved)
# This is also configurable via docker-compose.yml
OUTPUT_DIR=./data/output

# Local Music Library (mounted as volume in Docker)
# MUSIC_DIR=/music

# Photo & Processing Settings
PHOTO_DURATION_SECONDS=4
TRANSITION_DURATION_SECONDS=1
VIDEO_QUALITY=high

# Optional: Plex Integration
# PLEX_URL=http://your-plex-server:32400
# PLEX_TOKEN=your_plex_token
